[Defines]
  INF_VERSION       = 1.25
  BASE_NAME         = UefiCalculator
  FILE_GUID         = CE2DF8EC-AA9C-45D9-8188-A3BA430A538C
  MODULE_TYPE       = UEFI_APPLICATION
  VERSION_STRING    = 1.0
  ENTRY_POINT       = ShellCEntryLib

[Sources]
  main.c
  libs/tinyexpr.c

[Packages]
  MdePkg/MdePkg.dec
  ShellPkg/ShellPkg.dec
  StdLib/StdLib.dec

# Required Libraries
[LibraryClasses]
  UefiLib                      # UefiLib
  LibC
  ShellCEntryLib  
  LibMath

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -Wno-error -std=c23 -I$(MODULE_DIR)/include/